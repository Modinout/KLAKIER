HASLO_BAZY=zmien_mnie
# Opcjonalnie: adres zgodnego z OpenAI endpointu chat completions dużego otwartego modelu (drugi sędzia, nowe rodzaje oszustw).
DUZY_MODEL_URL=
DUZY_MODEL_NAZWA=
DUZY_MODEL_KLUCZ=
# Opcjonalnie: własne User-Agenty i proxy zbieraczy (http://host:port), po przecinku; każdy kontekst przeglądarki bierze kolejne.
ZBIERACZ_USER_AGENTS=
ZBIERACZ_PROXY=
# Opcjonalnie: token dostępu do oficjalnego API biblioteki reklam Mety; bez niego zbieracz pomija Metę.
META_TOKEN=
